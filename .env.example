# IP publique de la VM : nécessaire pour les candidats UDP dans Docker bridge.
UDP_ADVERTISE_ADDRESS=203.0.113.10
# HTTP local pour un proxy sur l'hôte ; HTTPS est nécessaire à distance.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
STUN_SERVER=
# Optionnel : compose.traefik.yaml, avec un certificat déjà géré par Traefik.
GAME_HOST=jeu.example.com
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_ENTRYPOINT=websecure
