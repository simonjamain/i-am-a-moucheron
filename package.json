{
  "name": "moucheron-flight-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/assemble.mjs && node server/index.js",
    "build": "node scripts/assemble.mjs && bash scripts/build.sh",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write src server scripts docs package.json",
    "format:check": "prettier --check src server scripts docs package.json",
    "start": "node scripts/assemble.mjs && node server/index.js",
    "test:udp": "node scripts/run-tests.mjs ram-game motion-capacity udp-client udp-native udp-mux tcp-fallback",
    "check:docs": "node scripts/check-docs.mjs",
    "test:capacity": "node scripts/assemble.mjs && node scripts/test-udp-capacity-50.mjs",
    "bench:swarm-50": "node scripts/benchmark-swept-broadphase.mjs",
    "bench:collisions": "node scripts/benchmark-insect-hitboxes.mjs",
    "bench:udp-replies": "node scripts/benchmark-udp-replies.mjs",
    "bench:tracers": "node scripts/benchmark-tracers.mjs",
    "bench:room-sync": "node scripts/benchmark-room-sync.mjs",
    "e2e:resume": "node scripts/assemble.mjs && node scripts/e2e-browser-resume.mjs",
    "e2e:motion": "node scripts/assemble.mjs && node scripts/e2e-browser-motion.mjs",
    "e2e:tcp": "node scripts/assemble.mjs && node scripts/e2e-browser-tcp-fallback.mjs",
    "e2e": "node scripts/run-tests.mjs --e2e",
    "e2e:loading": "node scripts/assemble.mjs && node scripts/e2e-loading.mjs",
    "e2e:layouts": "node scripts/assemble.mjs && node scripts/e2e-layouts.mjs",
    "pretypecheck": "node scripts/build-info.ts",
    "typecheck": "tsc -p tsconfig.json",
    "ts:migrate": "node scripts/ts-migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "node-datachannel": "0.33.6",
    "ws": "8.23.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
